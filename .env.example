# Keystatic — GitHub Storage (production)
# Create a GitHub OAuth App: Authorization callback URL = https://<your-domain>/api/keystatic/oauth/callback
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Repo where content is stored (public, read by the client)
NEXT_PUBLIC_KEYSTATIC_REPO_OWNER=
NEXT_PUBLIC_KEYSTATIC_REPO_NAME=

# Admin route protection (Basic Auth in production)
KEYSTATIC_ADMIN_USERNAME=
KEYSTATIC_ADMIN_PASSWORD=

# Public site URL (used for metadataBase / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:4000
